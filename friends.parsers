// Friends of Knowbooks — testimonials from our friends.
// Prefer the word "friends" over "customers" everywhere.
// No catalog to maintain. Drop a file in this folder and rebuild.
// Name:  YYYY-MM-DD FriendName -- Optional quote.jpeg   (also .jpg .png .webp .gif .avif)
// Newest first. Optional: put a smaller copy at web/<same filename> for faster loads; the page links to the original.
friendsDataParser
 extends abstractScrollParser
 cueFromId
 description Inline const friendsData = [...] built from the friend image filenames in this folder.
 javascript
  buildHtml() {
   const json = JSON.stringify(this.isNodeJs() ? this.friends : [], undefined, 1).replace(/</g, "\\u003c")
   return `<script>const friendsData = ${json}</script>`
  }
  get friends() {
   const fs = require("fs")
   const path = require("path")
   const {folderPath} = this.root
   const url = name => encodeURIComponent(name).replace(/['()]/g, c => "%" + c.charCodeAt(0).toString(16).toUpperCase())
   const slug = text => text.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "")
   const pattern = /^(\d{4}-\d{2}-\d{2}) (.+?)(?: -- (.+))?\.(jpe?g|png|webp|gif|avif)$/i
   return fs.readdirSync(folderPath).sort().reverse().map(file => {
     const match = file.normalize("NFC").match(pattern)
     if (!match) {
      if (/\.(jpe?g|png|webp|gif|avif)$/i.test(file) && !file.startsWith("og.")) this.root.log(`⚠️  Skipped ${file}: name it "YYYY-MM-DD FriendName -- Optional quote.jpeg"`)
      return undefined
     }
     const [, date, title, caption] = match
     const friend = {id: slug(date + " " + title), title: title.trim(), date, image: url(file)}
     if (caption) friend.caption = caption.trim()
     if (fs.existsSync(path.join(folderPath, "web", file))) friend.web = "web/" + url(file)
     return friend
    }).filter(Boolean)
  }